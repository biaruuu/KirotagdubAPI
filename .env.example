# Hosted (Vercel): set DATABASE_URL (Neon Postgres) and BLOB_READ_WRITE_TOKEN. Leave empty to run locally with SQLite.
DATABASE_URL=
PORT=8787
# Where the database and uploaded videos live (mount a volume here when deploying).
DATA_DIR=./data
# Key for the admin page and write endpoints. Leave empty to generate one on first start.
ADMIN_KEY=
# Public address of this API, used to build stream links. Leave empty to use the request's host.
PUBLIC_URL=
MAX_UPLOAD_MB=4096
